# Copy to `.env`: server.sh exports every line. See config/database.sh for the defaults.

# local | development | production
APP_ENV=local
# debug | info | error | none; by default info, and error in production (see config/app.sh)
#LOG_LEVEL=info

# the port server.sh listens on (an argument to server.sh wins over it)
PORT=3000

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
#DB_CONNECTION=pgsql
#DB_DATABASE=conch
#DB_HOST=127.0.0.1
#DB_PORT=5432
#DB_USERNAME=conch
#DB_PASSWORD=secret
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
